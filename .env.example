# Copy to .env or set as a user environment variable. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Insight layer (lifecycle, debt, metrics, diagrams, assistant) ---------------------------------
# SCANNER_ENGINE=jqassistant        # 'bytecode' = built-in class-file reader only (no JDK needed)
# BYTECODE_FACTS_ENABLED=true       # per-class bytecode facts stored with each analysis
# SOURCE_STORE_MODE=ALLOW           # DENY = never store or read uploaded .java sources
# INSIGHT_AI_MODE=LOCAL_ONLY        # OFF = no model is ever called by the insight layer
# ASSISTANT_REQUESTS_PER_HOUR=120
# LIFECYCLE_RULES_MAX_AGE_DAYS=180  # warn when the lifecycle rules file is older than this
