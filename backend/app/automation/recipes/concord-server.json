{
  "id": "concord-server",
  "title": "Walmart Concord server (with a disposable PostgreSQL)",
  "description": "Starts the Concord server from its distribution (concord-server-<version>-dist.tar.gz) on a fresh PostgreSQL container, with a generated admin API token. Processes are queued but not executed, because no Concord agent is started.",
  "distribution_hint": "server/dist/target/concord-server-<version>-dist.tar.gz from a Concord build",
  "recipe": {
    "name": "concord-server",
    "main_class": "com.walmartlabs.concord.server.dist.Main",
    "classpath": [
      "lib/*",
      "ext/*",
      "classes"
    ],
    "jvm_args": [
      "-Xms512m",
      "-Xmx1536m",
      "--add-opens",
      "java.base/java.lang=ALL-UNNAMED",
      "--add-opens",
      "java.base/java.util=ALL-UNNAMED",
      "-Dfile.encoding=UTF-8",
      "-Djava.net.preferIPv4Stack=true",
      "-Dpolyglot.engine.WarnInterpreterOnly=false"
    ],
    "system_properties": {
      "concord.conf": "${FILE:concord.conf}"
    },
    "env": {
      "CONCORD_TMP_DIR": "${RUN_DIR}"
    },
    "generated_secrets": [
      {
        "name": "DB_PASSWORD",
        "kind": "password"
      },
      {
        "name": "ADMIN_TOKEN",
        "kind": "base64"
      },
      {
        "name": "AGENT_TOKEN",
        "kind": "base64"
      },
      {
        "name": "SECRET_KEY",
        "kind": "base64"
      },
      {
        "name": "SECRET_SALT",
        "kind": "base64"
      },
      {
        "name": "PROJECT_SALT",
        "kind": "base64"
      }
    ],
    "dependencies": [
      {
        "name": "db",
        "image": "postgres:14.21-alpine",
        "port": 5432,
        "env": {
          "POSTGRES_PASSWORD": "${DB_PASSWORD}",
          "POSTGRES_INITDB_ARGS": "--no-sync"
        },
        "ready_log": "database system is ready to accept connections",
        "ready_log_count": 2
      }
    ],
    "config_files": [
      {
        "name": "concord.conf",
        "content": "concord-server {\n    server {\n        port = ${PORT}\n    }\n    db {\n        url = \"jdbc:postgresql://127.0.0.1:${DB_PORT}/postgres\"\n        appUsername = \"postgres\"\n        appPassword = \"${DB_PASSWORD}\"\n        inventoryUsername = \"postgres\"\n        inventoryPassword = \"${DB_PASSWORD}\"\n        changeLogParameters {\n            defaultAdminToken = \"${ADMIN_TOKEN}\"\n            defaultAgentToken = \"${AGENT_TOKEN}\"\n        }\n    }\n    secretStore {\n        serverPassword = \"${SECRET_KEY}\"\n        secretStoreSalt = \"${SECRET_SALT}\"\n        projectSecretSalt = \"${PROJECT_SALT}\"\n    }\n}\n"
      }
    ],
    "ready": {
      "path": "/api/v1/server/ping",
      "timeout_ms": 420000
    },
    "credential": {
      "header": "Authorization",
      "value": "Bearer ${ADMIN_TOKEN}"
    }
  },
  "instrumentation": {
    "mode": "DEEP",
    "exclude_packages": [
      "com.walmartlabs.concord.agent",
      "com.walmartlabs.concord.runtime.v2.runner",
      "com.walmartlabs.concord.runtime.v1",
      "com.walmartlabs.concord.runner",
      "com.walmartlabs.concord.client2",
      "com.walmartlabs.concord.plugins",
      "com.walmartlabs.concord.cli"
    ]
  },
  "exploration": {
    "skip_paths": [
      "/waitForCompletion$",
      "/log/segment/\\{segmentId\\}/data$"
    ],
    "max_requests": 800,
    "passes": 5
  },
  "scenarios": [
    {
      "name": "Organization lifecycle",
      "description": "Creates an organization with a project, secret, team, inventory, JSON store and policy, starts a process from a concord.yml payload, reads everything back, then removes it.",
      "steps": [
        {
          "id": "create-org",
          "method": "POST",
          "path": "/api/v1/org",
          "json": {
            "name": "archintel-${RUN_ID}"
          }
        },
        {
          "id": "create-project",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/project",
          "json": {
            "name": "project-${RUN_ID}",
            "rawPayloadMode": "EVERYONE",
            "description": "Created by ArchIntel exploration"
          }
        },
        {
          "id": "create-secret",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/secret",
          "multipart": {
            "name": "secret-${RUN_ID}",
            "type": "USERNAME_PASSWORD",
            "username": "archintel",
            "password": "not-a-real-password-${RUN_ID}"
          }
        },
        {
          "id": "read-secret",
          "method": "GET",
          "path": "/api/v1/org/archintel-${RUN_ID}/secret/secret-${RUN_ID}"
        },
        {
          "id": "create-team",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/team",
          "json": {
            "name": "team-${RUN_ID}",
            "description": "Created by ArchIntel exploration"
          }
        },
        {
          "id": "add-team-member",
          "method": "PUT",
          "path": "/api/v1/org/archintel-${RUN_ID}/team/team-${RUN_ID}/users",
          "json": [
            {
              "username": "admin",
              "role": "MEMBER"
            }
          ]
        },
        {
          "id": "list-team-members",
          "method": "GET",
          "path": "/api/v1/org/archintel-${RUN_ID}/team/team-${RUN_ID}/users"
        },
        {
          "id": "create-inventory",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/inventory",
          "json": {
            "name": "inventory-${RUN_ID}"
          }
        },
        {
          "id": "write-inventory-data",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/inventory/inventory-${RUN_ID}/data/host-1",
          "json": {
            "address": "192.0.2.10",
            "role": "web"
          }
        },
        {
          "id": "read-inventory-data",
          "method": "GET",
          "path": "/api/v1/org/archintel-${RUN_ID}/inventory/inventory-${RUN_ID}/data/host-1"
        },
        {
          "id": "create-jsonstore",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/jsonstore",
          "json": {
            "name": "store-${RUN_ID}"
          }
        },
        {
          "id": "write-jsonstore-item",
          "method": "PUT",
          "path": "/api/v1/org/archintel-${RUN_ID}/jsonstore/store-${RUN_ID}/item/item-1",
          "json": {
            "status": "recorded",
            "count": 3
          }
        },
        {
          "id": "read-jsonstore-item",
          "method": "GET",
          "path": "/api/v1/org/archintel-${RUN_ID}/jsonstore/store-${RUN_ID}/item/item-1"
        },
        {
          "id": "create-jsonstore-query",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/jsonstore/store-${RUN_ID}/query",
          "json": {
            "name": "all-items",
            "text": "select item_data from json_store_data"
          }
        },
        {
          "id": "create-policy",
          "method": "POST",
          "path": "/api/v2/policy",
          "json": {
            "name": "policy-${RUN_ID}",
            "rules": {
              "concurrentProcess": {
                "maxPerOrg": 10
              }
            }
          }
        },
        {
          "id": "link-policy",
          "method": "PUT",
          "path": "/api/v2/policy/policy-${RUN_ID}/link",
          "json": {
            "orgName": "archintel-${RUN_ID}"
          }
        },
        {
          "id": "create-role",
          "method": "POST",
          "path": "/api/v1/role",
          "json": {
            "name": "role-${RUN_ID}",
            "permissions": []
          }
        },
        {
          "id": "create-user",
          "method": "POST",
          "path": "/api/v1/user",
          "json": {
            "username": "user-${RUN_ID}",
            "type": "LOCAL",
            "displayName": "ArchIntel exploration user"
          },
          "extract": {
            "USER_ID": "id"
          }
        },
        {
          "id": "assign-user-role",
          "method": "POST",
          "path": "/api/v1/user/user-${RUN_ID}/roles",
          "json": {
            "roles": [
              "role-${RUN_ID}"
            ]
          }
        },
        {
          "id": "create-user-api-key",
          "method": "POST",
          "path": "/api/v1/apikey",
          "json": {
            "username": "user-${RUN_ID}"
          },
          "extract": {
            "API_KEY_ID": "id"
          }
        },
        {
          "id": "start-process",
          "method": "POST",
          "path": "/api/v1/process",
          "multipart": {
            "org": "archintel-${RUN_ID}",
            "project": "project-${RUN_ID}",
            "concord.yml": {
              "filename": "concord.yml",
              "type": "application/octet-stream",
              "content": "flows:\n  default:\n    - log: \"Hello from ArchIntel exploration\"\n"
            }
          },
          "extract": {
            "PROCESS_ID": "instanceId"
          }
        },
        {
          "id": "read-process",
          "method": "GET",
          "path": "/api/v1/process/${PROCESS_ID}"
        },
        {
          "id": "read-process-v2",
          "method": "GET",
          "path": "/api/v2/process/${PROCESS_ID}?include=checkpoints&include=history"
        },
        {
          "id": "read-process-log",
          "method": "GET",
          "path": "/api/v1/process/${PROCESS_ID}/log"
        },
        {
          "id": "list-org-processes",
          "method": "GET",
          "path": "/api/v2/process?orgName=archintel-${RUN_ID}&limit=10"
        }
      ],
      "cleanup": [
        {
          "id": "kill-process",
          "method": "DELETE",
          "path": "/api/v1/process/${PROCESS_ID}"
        },
        {
          "id": "delete-api-key",
          "method": "DELETE",
          "path": "/api/v1/apikey/${API_KEY_ID}"
        },
        {
          "id": "delete-user",
          "method": "DELETE",
          "path": "/api/v1/user/${USER_ID}"
        },
        {
          "id": "delete-role",
          "method": "DELETE",
          "path": "/api/v1/role/role-${RUN_ID}"
        },
        {
          "id": "unlink-policy",
          "method": "DELETE",
          "path": "/api/v2/policy/policy-${RUN_ID}/link?orgName=archintel-${RUN_ID}"
        },
        {
          "id": "delete-policy",
          "method": "DELETE",
          "path": "/api/v2/policy/policy-${RUN_ID}"
        },
        {
          "id": "delete-jsonstore",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}/jsonstore/store-${RUN_ID}"
        },
        {
          "id": "delete-inventory",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}/inventory/inventory-${RUN_ID}"
        },
        {
          "id": "delete-team",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}/team/team-${RUN_ID}"
        },
        {
          "id": "delete-secret",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}/secret/secret-${RUN_ID}"
        },
        {
          "id": "delete-project",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}/project/project-${RUN_ID}"
        },
        {
          "id": "delete-org",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}?confirmation=yes"
        }
      ]
    }
  ]
}
