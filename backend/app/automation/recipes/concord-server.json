{
  "id": "concord-server",
  "title": "Walmart Concord server and agent (with a disposable PostgreSQL)",
  "description": "Starts the Concord server from concord-server-<version>-dist.tar.gz on a fresh PostgreSQL container with a generated admin API token, then the Concord agent from concord-agent-<version>-dist.tar.gz with a generated agent token. The agent runs every submitted process in its own JVM, and the OpenTelemetry agent is passed on to those JVMs, so server, agent and process runtime are all traced.",
  "distribution_hint": "server/dist/target/concord-server-<version>-dist.tar.gz",
  "recipe": {
    "name": "concord-server",
    "main_class": "com.walmartlabs.concord.server.dist.Main",
    "classpath": [
      "lib/*",
      "ext/*",
      "classes"
    ],
    "jvm_args": [
      "-Xms512m",
      "-Xmx1536m",
      "--add-opens",
      "java.base/java.lang=ALL-UNNAMED",
      "--add-opens",
      "java.base/java.util=ALL-UNNAMED",
      "-Dfile.encoding=UTF-8",
      "-Djava.net.preferIPv4Stack=true",
      "-Dpolyglot.engine.WarnInterpreterOnly=false"
    ],
    "system_properties": {
      "concord.conf": "${FILE:concord.conf}"
    },
    "env": {
      "CONCORD_TMP_DIR": "${RUN_DIR}"
    },
    "generated_secrets": [
      {
        "name": "DB_PASSWORD",
        "kind": "password"
      },
      {
        "name": "ADMIN_TOKEN",
        "kind": "base64"
      },
      {
        "name": "AGENT_TOKEN",
        "kind": "base64"
      },
      {
        "name": "SECRET_KEY",
        "kind": "base64"
      },
      {
        "name": "SECRET_SALT",
        "kind": "base64"
      },
      {
        "name": "PROJECT_SALT",
        "kind": "base64"
      }
    ],
    "dependencies": [
      {
        "name": "db",
        "image": "postgres:14.21-alpine",
        "port": 5432,
        "env": {
          "POSTGRES_PASSWORD": "${DB_PASSWORD}",
          "POSTGRES_INITDB_ARGS": "--no-sync"
        },
        "ready_log": "database system is ready to accept connections",
        "ready_log_count": 2
      }
    ],
    "config_files": [
      {
        "name": "concord.conf",
        "content": "concord-server {\n    server {\n        port = ${PORT}\n    }\n    db {\n        url = \"jdbc:postgresql://127.0.0.1:${DB_PORT}/postgres\"\n        appUsername = \"postgres\"\n        appPassword = \"${DB_PASSWORD}\"\n        inventoryUsername = \"postgres\"\n        inventoryPassword = \"${DB_PASSWORD}\"\n        changeLogParameters {\n            defaultAdminToken = \"${ADMIN_TOKEN}\"\n            defaultAgentToken = \"${AGENT_TOKEN}\"\n        }\n    }\n    # The agent key of a fresh database has no user, so the agent WebSocket cannot carry the AGENT_WEBSOCKET permission check.\n    websockets {\n        requirePermission = false\n    }\n    secretStore {\n        serverPassword = \"${SECRET_KEY}\"\n        secretStoreSalt = \"${SECRET_SALT}\"\n        projectSecretSalt = \"${PROJECT_SALT}\"\n    }\n}\n"
      },
      {
        "name": "agent.conf",
        "content": "concord-agent {\n    workersCount = 2\n    workDirBase = \"${RUN_DIR}/agent-work\"\n    maintenanceModeListenerHost = \"127.0.0.1\"\n    maintenanceModeListenerPort = ${AGENT_MM_PORT}\n    server {\n        apiBaseUrl = \"http://127.0.0.1:${PORT}\"\n        websocketUrl = \"ws://127.0.0.1:${PORT}/websocket\"\n        apiKey = \"${AGENT_TOKEN}\"\n    }\n    runner {\n        jvmParams = [\"-Xmx256m\", \"-XX:+ExitOnOutOfMemoryError\", \"${OTEL_JVM_ARG}\"]\n    }\n    runnerV2 {\n        jvmParams = [\"-Xmx256m\", \"-XX:+ExitOnOutOfMemoryError\", \"${OTEL_JVM_ARG}\"]\n    }\n}\n"
      }
    ],
    "ready": {
      "path": "/api/v1/server/ping",
      "timeout_ms": 420000
    },
    "credential": {
      "header": "Authorization",
      "value": "Bearer ${ADMIN_TOKEN}"
    },
    "ports": [
      "AGENT_MM_PORT"
    ],
    "companions": [
      {
        "name": "agent",
        "distribution": "agent",
        "main_class": "com.walmartlabs.concord.agent.Main",
        "classpath": [
          "lib/*"
        ],
        "jvm_args": [
          "-Xmx512m",
          "--add-opens",
          "java.base/java.lang=ALL-UNNAMED",
          "--add-opens",
          "java.base/java.util=ALL-UNNAMED",
          "-Dfile.encoding=UTF-8",
          "-Djava.net.preferIPv4Stack=true"
        ],
        "system_properties": {
          "concord.conf": "${FILE:agent.conf}",
          "logback.configurationFile": "com/walmartlabs/concord/agent/logback.xml"
        },
        "env": {
          "RUNNER_V1_PATH": "${DIST_DIR_AGENT}/runner/runner-v1.jar",
          "RUNNER_V2_PATH": "${DIST_DIR_AGENT}/runner/runner-v2.jar",
          "CONCORD_TMP_DIR": "${RUN_DIR}"
        },
        "ready_log": "run -> using",
        "ready_timeout_ms": 180000
      }
    ]
  },
  "instrumentation": {
    "mode": "DEEP",
    "exclude_packages": [
      "com.walmartlabs.concord.cli"
    ]
  },
  "exploration": {
    "skip_paths": [
      "/waitForCompletion$",
      "/log/segment/\\{segmentId\\}/data$"
    ],
    "max_requests": 800,
    "passes": 5
  },
  "scenarios": [
    {
      "name": "Organization lifecycle",
      "description": "Creates an organization with a project, secret, team, inventory, JSON store and policy, runs a process to completion on the agent with runtime v2, runs a second process on runtime v1 that waits on a form and submits it, reads everything back, then removes it.",
      "steps": [
        {
          "id": "create-org",
          "method": "POST",
          "path": "/api/v1/org",
          "json": {
            "name": "archintel-${RUN_ID}"
          }
        },
        {
          "id": "create-project",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/project",
          "json": {
            "name": "project-${RUN_ID}",
            "rawPayloadMode": "EVERYONE",
            "description": "Created by ArchIntel exploration"
          }
        },
        {
          "id": "create-secret",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/secret",
          "multipart": {
            "name": "secret-${RUN_ID}",
            "type": "USERNAME_PASSWORD",
            "username": "archintel",
            "password": "not-a-real-password-${RUN_ID}"
          }
        },
        {
          "id": "read-secret",
          "method": "GET",
          "path": "/api/v1/org/archintel-${RUN_ID}/secret/secret-${RUN_ID}"
        },
        {
          "id": "create-team",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/team",
          "json": {
            "name": "team-${RUN_ID}",
            "description": "Created by ArchIntel exploration"
          }
        },
        {
          "id": "add-team-member",
          "method": "PUT",
          "path": "/api/v1/org/archintel-${RUN_ID}/team/team-${RUN_ID}/users",
          "json": [
            {
              "username": "admin",
              "role": "MEMBER"
            }
          ]
        },
        {
          "id": "list-team-members",
          "method": "GET",
          "path": "/api/v1/org/archintel-${RUN_ID}/team/team-${RUN_ID}/users"
        },
        {
          "id": "create-inventory",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/inventory",
          "json": {
            "name": "inventory-${RUN_ID}"
          }
        },
        {
          "id": "write-inventory-data",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/inventory/inventory-${RUN_ID}/data/host-1",
          "json": {
            "address": "192.0.2.10",
            "role": "web"
          }
        },
        {
          "id": "read-inventory-data",
          "method": "GET",
          "path": "/api/v1/org/archintel-${RUN_ID}/inventory/inventory-${RUN_ID}/data/host-1"
        },
        {
          "id": "create-jsonstore",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/jsonstore",
          "json": {
            "name": "store-${RUN_ID}"
          }
        },
        {
          "id": "write-jsonstore-item",
          "method": "PUT",
          "path": "/api/v1/org/archintel-${RUN_ID}/jsonstore/store-${RUN_ID}/item/item-1",
          "json": {
            "status": "recorded",
            "count": 3
          }
        },
        {
          "id": "read-jsonstore-item",
          "method": "GET",
          "path": "/api/v1/org/archintel-${RUN_ID}/jsonstore/store-${RUN_ID}/item/item-1"
        },
        {
          "id": "create-jsonstore-query",
          "method": "POST",
          "path": "/api/v1/org/archintel-${RUN_ID}/jsonstore/store-${RUN_ID}/query",
          "json": {
            "name": "all-items",
            "text": "select item_data from json_store_data"
          }
        },
        {
          "id": "create-policy",
          "method": "POST",
          "path": "/api/v2/policy",
          "json": {
            "name": "policy-${RUN_ID}",
            "rules": {
              "concurrentProcess": {
                "maxPerOrg": 10
              }
            }
          }
        },
        {
          "id": "link-policy",
          "method": "PUT",
          "path": "/api/v2/policy/policy-${RUN_ID}/link",
          "json": {
            "orgName": "archintel-${RUN_ID}"
          }
        },
        {
          "id": "create-role",
          "method": "POST",
          "path": "/api/v1/role",
          "json": {
            "name": "role-${RUN_ID}",
            "permissions": []
          }
        },
        {
          "id": "create-user",
          "method": "POST",
          "path": "/api/v1/user",
          "json": {
            "username": "user-${RUN_ID}",
            "type": "LOCAL",
            "displayName": "ArchIntel exploration user"
          },
          "extract": {
            "USER_ID": "id"
          }
        },
        {
          "id": "assign-user-role",
          "method": "POST",
          "path": "/api/v1/user/user-${RUN_ID}/roles",
          "json": {
            "roles": [
              "role-${RUN_ID}"
            ]
          }
        },
        {
          "id": "create-user-api-key",
          "method": "POST",
          "path": "/api/v1/apikey",
          "json": {
            "username": "user-${RUN_ID}"
          },
          "extract": {
            "API_KEY_ID": "id"
          }
        },
        {
          "id": "start-process",
          "method": "POST",
          "path": "/api/v1/process",
          "multipart": {
            "org": "archintel-${RUN_ID}",
            "project": "project-${RUN_ID}",
            "concord.yml": {
              "filename": "concord.yml",
              "type": "application/octet-stream",
              "content": "configuration:\n  runtime: \"concord-v2\"\n  arguments:\n    greeting: \"Hello from ArchIntel exploration\"\nflows:\n  default:\n    - log: \"${greeting}\"\n    - set:\n        counter: 3\n    - if: ${counter > 2}\n      then:\n        - call: helper\n    - try:\n        - throw: \"expected failure\"\n      error:\n        - log: \"handled the expected failure\"\n  helper:\n    - log: \"helper flow, counter ${counter}\"\n"
            }
          },
          "extract": {
            "PROCESS_ID": "instanceId"
          }
        },
        {
          "id": "wait-for-process",
          "method": "GET",
          "path": "/api/v1/process/${PROCESS_ID}",
          "until": {
            "path": "status",
            "in": [
              "FINISHED",
              "FAILED",
              "CANCELLED",
              "TIMED_OUT"
            ],
            "timeout_ms": 300000,
            "interval_ms": 2000,
            "success": [
              "FINISHED"
            ]
          }
        },
        {
          "id": "read-process",
          "method": "GET",
          "path": "/api/v1/process/${PROCESS_ID}"
        },
        {
          "id": "read-process-v2",
          "method": "GET",
          "path": "/api/v2/process/${PROCESS_ID}?include=checkpoints&include=history"
        },
        {
          "id": "read-process-log",
          "method": "GET",
          "path": "/api/v1/process/${PROCESS_ID}/log"
        },
        {
          "id": "list-org-processes",
          "method": "GET",
          "path": "/api/v2/process?orgName=archintel-${RUN_ID}&limit=10"
        },
        {
          "id": "read-process-events",
          "method": "GET",
          "path": "/api/v1/process/${PROCESS_ID}/event"
        },
        {
          "id": "read-process-checkpoints",
          "method": "GET",
          "path": "/api/v1/process/${PROCESS_ID}/checkpoint"
        },
        {
          "id": "start-form-process",
          "method": "POST",
          "path": "/api/v1/process",
          "multipart": {
            "org": "archintel-${RUN_ID}",
            "project": "project-${RUN_ID}",
            "concord.yml": {
              "filename": "concord.yml",
              "type": "application/octet-stream",
              "content": "flows:\n  default:\n    - form: approval\n    - log: \"Approved by ${approval.name}: ${approval.approved}\"\nforms:\n  approval:\n    - name: { label: \"Name\", type: \"string\" }\n    - approved: { label: \"Approved\", type: \"boolean\" }\n"
            }
          },
          "extract": {
            "FORM_PROCESS_ID": "instanceId"
          }
        },
        {
          "id": "wait-for-form",
          "method": "GET",
          "path": "/api/v1/process/${FORM_PROCESS_ID}",
          "until": {
            "path": "status",
            "in": [
              "SUSPENDED",
              "FAILED",
              "FINISHED"
            ],
            "timeout_ms": 300000,
            "interval_ms": 2000,
            "success": [
              "SUSPENDED"
            ]
          }
        },
        {
          "id": "list-forms",
          "method": "GET",
          "path": "/api/v1/process/${FORM_PROCESS_ID}/form"
        },
        {
          "id": "read-form",
          "method": "GET",
          "path": "/api/v1/process/${FORM_PROCESS_ID}/form/approval"
        },
        {
          "id": "submit-form",
          "method": "POST",
          "path": "/api/v1/process/${FORM_PROCESS_ID}/form/approval",
          "json": {
            "name": "ArchIntel",
            "approved": true
          }
        },
        {
          "id": "wait-for-form-process",
          "method": "GET",
          "path": "/api/v1/process/${FORM_PROCESS_ID}",
          "until": {
            "path": "status",
            "in": [
              "FINISHED",
              "FAILED",
              "CANCELLED",
              "TIMED_OUT"
            ],
            "timeout_ms": 300000,
            "interval_ms": 2000,
            "success": [
              "FINISHED"
            ]
          }
        },
        {
          "id": "read-form-process-events",
          "method": "GET",
          "path": "/api/v1/process/${FORM_PROCESS_ID}/event"
        }
      ],
      "cleanup": [
        {
          "id": "kill-process",
          "method": "DELETE",
          "path": "/api/v1/process/${PROCESS_ID}"
        },
        {
          "id": "delete-api-key",
          "method": "DELETE",
          "path": "/api/v1/apikey/${API_KEY_ID}"
        },
        {
          "id": "delete-user",
          "method": "DELETE",
          "path": "/api/v1/user/${USER_ID}"
        },
        {
          "id": "delete-role",
          "method": "DELETE",
          "path": "/api/v1/role/role-${RUN_ID}"
        },
        {
          "id": "unlink-policy",
          "method": "DELETE",
          "path": "/api/v2/policy/policy-${RUN_ID}/link?orgName=archintel-${RUN_ID}"
        },
        {
          "id": "delete-policy",
          "method": "DELETE",
          "path": "/api/v2/policy/policy-${RUN_ID}"
        },
        {
          "id": "delete-jsonstore",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}/jsonstore/store-${RUN_ID}"
        },
        {
          "id": "delete-inventory",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}/inventory/inventory-${RUN_ID}"
        },
        {
          "id": "delete-team",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}/team/team-${RUN_ID}"
        },
        {
          "id": "delete-secret",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}/secret/secret-${RUN_ID}"
        },
        {
          "id": "delete-project",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}/project/project-${RUN_ID}"
        },
        {
          "id": "delete-org",
          "method": "DELETE",
          "path": "/api/v1/org/archintel-${RUN_ID}?confirmation=yes"
        }
      ]
    }
  ],
  "distributions": [
    {
      "id": "server",
      "primary": true,
      "title": "Concord server distribution",
      "hint": "server/dist/target/concord-server-<version>-dist.tar.gz"
    },
    {
      "id": "agent",
      "title": "Concord agent distribution",
      "hint": "agent/target/concord-agent-<version>-dist.tar.gz"
    }
  ]
}
